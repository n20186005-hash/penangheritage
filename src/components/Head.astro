---
import { languages, languagesList, defaultLang, pathForLang, type Lang, type PageContent } from '../i18n/ui';

interface Props {
  content: PageContent;
  lang: Lang;
  siteUrl: string;
  pathname: string;
}
declare global {
  interface Window {
    dataLayer: unknown[];
    gtag: (...args: unknown[]) => void;
    __gtAnalyticsId: string;
    __gtAnalyticsLoaded: boolean;
    __gtLoadAnalytics: () => void;
    __gtSetAnalyticsConsent: (enabled: boolean) => void;
    [key: `ga-disable-${string}`]: boolean | unknown;
  }
}
const { content, lang, siteUrl, pathname } = Astro.props;
const canonical = siteUrl ? `${siteUrl}${pathname === '/' ? '/' : pathname}` : pathname;
const hrefFor = (l: Lang) => `${siteUrl}${pathForLang(l)}`;
const ogImage = `${siteUrl}/og-cover.jpg`;
const heroImage = '/gallery/webp/georgetown-unesco-historic-site-1-1600.webp';
const mapsUrl = 'https://maps.app.goo.gl/iTorS1Eh1hJkpMXp9';
const touristJson = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: content.meta.jsonldName,
  description: content.meta.jsonldDescription,
  url: canonical,
  image: [ogImage],
  sameAs: ['https://whc.unesco.org/en/list/1223'],
  inLanguage: languages[lang].htmlLang,
  availableLanguage: languagesList.map((l) => languages[l].htmlLang),
  address: { '@type': 'PostalAddress', streetAddress: '159, Lebuh Chulia', addressLocality: 'George Town', postalCode: '10200', addressRegion: 'Pulau Pinang', addressCountry: 'MY' },
  geo: { '@type': 'GeoCoordinates', latitude: 5.417003694539544, longitude: 100.3353972121393 },
  hasMap: mapsUrl,
  openingHours: 'Mo-Su 00:00-23:59',
  isAccessibleForFree: true,
  publicAccess: true,
  touristType: ['Culture', 'Sightseeing'],
  includesAttraction: content.nearby.items.map((x) => ({ '@type': 'TouristAttraction', name: x.title, description: x.text })),
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.4', ratingCount: '13491' }
};
const faqJson = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: content.faq.items.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } }))
};
---
<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{content.meta.title}</title>
    <meta name="description" content={content.meta.description} />
    <link rel="canonical" href={canonical} />
    {siteUrl && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content={content.meta.ogTitle} />
    <meta property="og:description" content={content.meta.ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={content.hero.imageAlt} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={content.meta.ogTitle} />
    <meta name="twitter:description" content={content.meta.ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    {languagesList.map((l) => <link rel="alternate" hreflang={languages[l].hreflang} href={hrefFor(l)} />)}
    <link rel="alternate" hreflang="x-default" href={hrefFor(defaultLang)} />
    <link rel="icon" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <link rel="preload" as="image" href={heroImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap" />
    <script is:inline>
      window.__gtAnalyticsId = 'G-HXM22WWPKP';
      window.__gtAnalyticsLoaded = false;
      window.__gtLoadAnalytics = function () {
        if (window.__gtAnalyticsLoaded) return;
        window.__gtAnalyticsLoaded = true;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', window.__gtAnalyticsId);
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + window.__gtAnalyticsId;
        document.head.appendChild(script);
      };
      window.__gtSetAnalyticsConsent = function (enabled) {
        const gaDisableKey = `ga-disable-${window.__gtAnalyticsId}`;
        Object.assign(window, { [gaDisableKey]: !enabled });
        if (enabled) window.__gtLoadAnalytics();
      };
      try {
        var stored = localStorage.getItem('gt-cookie-preferences');
        var prefs = stored ? JSON.parse(stored) : null;
        window.__gtSetAnalyticsConsent(!!(prefs && prefs.analytics === true));
      } catch (_) {
        window.__gtSetAnalyticsConsent(false);
      }
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(touristJson)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJson)} />
  </head>
