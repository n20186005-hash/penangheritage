---
// Design philosophy: Straits Heritage Editorial — warm limewash, indigo ink, brass accents,
// asymmetric editorial rhythm, archival labels, and map-led storytelling for a living historic city.
// Bahasa Melayu ialah bahasa lalai dan dihidangkan di laluan akar ( / ).
import '../styles.css';
import { defaultLang } from '../i18n/ui';
import { content as msContent } from '../i18n/ms';
import Head from '../components/Head.astro';
import PageBody from '../components/PageBody.astro';

export const prerender = true;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const lang = defaultLang;
---
<Head content={msContent} lang={lang} siteUrl={siteUrl} pathname={Astro.url.pathname} />
<body>
  <PageBody content={msContent} lang={lang} />
</body>
