---
// Design philosophy: Straits Heritage Editorial — warm limewash, indigo ink, brass accents,
// asymmetric editorial rhythm, archival labels, and map-led storytelling for a living historic city.
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const canonical = siteUrl ? `${siteUrl}${Astro.url.pathname}` : Astro.url.pathname;
import '../styles.css';

const attractions = [
  { title: '姓氏桥', tag: '水上社区', text: '走进海上木屋与潮汐之间，感受槟城华人移民社群的日常尺度。', image: 'https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1000&q=85' },
  { title: '壁画街区', tag: '城市漫游', text: '沿着 Lebuh Armenian 与周边小巷寻找铁艺壁画和街头艺术。', image: 'https://images.unsplash.com/photo-1518005020951-eccb494ad742?auto=format&fit=crop&w=1000&q=85' },
  { title: '邱公司', tag: '宗祠建筑', text: '精雕木作、金箔与宗族记忆，构成乔治市最具戏剧性的室内空间。', image: 'https://images.unsplash.com/photo-1531058020387-3be344556be6?auto=format&fit=crop&w=1000&q=85' }
];
const faqs = [
  ['乔治市 UNESCO 世界遗产区需要门票吗？', '历史街区本身开放步行参观，不收取统一门票。部分宗祠、博物馆和付费景点会另行售票，出发前请查看各自现场公告。'],
  ['从槟城国际机场怎么到这里？', '机场距离乔治市约 18 公里。可搭乘 Rapid Penang 公交，或使用出租车与网约车；行车时间会随交通状况变化，建议预留 35–60 分钟。'],
  ['适合安排多长时间？', '第一次到访建议留出半天至一天。若想慢慢看建筑、吃街头小吃并加入姓氏桥路线，一整天更从容。'],
  ['什么时候最适合步行？', '清晨与傍晚光线柔和、体感相对舒适。中午可把时间留给室内展馆、咖啡馆或一顿悠闲的娘惹菜。']
];
---
<!doctype html>
<html lang="ms">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>George Town UNESCO — Jejak Warisan</title>
    <meta name="description" content="Panduan berjalan kaki ke tapak Warisan Dunia UNESCO George Town, Pulau Pinang — sejarah, pengangkutan, makanan dan laluan pilihan." />
    <link rel="canonical" href={canonical} />
    {siteUrl && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content="George Town UNESCO — Jejak Warisan" />
    <meta property="og:description" content="Satu bandar pelabuhan, banyak lapisan cerita." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}/images/georgetown-hero.jpg`} />
    <link rel="icon" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-HXM22WWPKP');</script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org','@type':'TouristAttraction','name':'George Town UNESCO Historic Site','description':'Historic core of George Town, Penang, recognised for its unique architectural and cultural townscape.','address':{'@type':'PostalAddress','streetAddress':'159, Lebuh Chulia','addressLocality':'George Town','postalCode':'10200','addressRegion':'Pulau Pinang','addressCountry':'MY'},'geo':{'@type':'GeoCoordinates','latitude':5.417003694539544,'longitude':100.3353972121393},'openingHours':'Mo-Su 00:00-23:59','isAccessibleForFree':true,'aggregateRating':{'@type':'AggregateRating','ratingValue':'4.4','ratingCount':'13491'}
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage','mainEntity':faqs.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))})} />
  </head>
  <body>
    <header class="topbar"><a class="brand" href="#top" aria-label="Laman utama"><span class="brand-mark">GT</span><span>JEJAK<br/><b>WARISAN</b></span></a><nav><a href="#cerita">Cerita</a><a href="#laluan">Laluan</a><a href="#praktikal">Praktikal</a></nav><button class="save-top" data-save="George Town UNESCO Historic Site">＋ Simpan pelan</button></header>
    <main id="top">
      <section class="hero"><div class="hero-copy"><p class="eyebrow">PULAU PINANG · MALAYSIA</p><h1>Bandar pelabuhan,<br/><em>seribu lapis cerita.</em></h1><p class="lede">George Town UNESCO Historic Site bukan muzium yang beku. Ia ialah bandar yang masih bernafas — di antara kedai lama, rumah ibadat, gerai sarapan dan bayang petang.</p><div class="hero-actions"><a class="button dark" href="#laluan">Mulakan berjalan <span>↘</span></a><button class="button outline" data-save="Laluan George Town">＋ Simpan laluan</button></div><div class="hero-note"><span>01</span><p>Tapak Warisan Dunia UNESCO sejak 2008<br/><small>Berjalan kaki adalah cara terbaik untuk membaca bandar ini.</small></p></div></div><div class="hero-image"><img src="https://images.unsplash.com/photo-1596422846543-75c6fc197f07?auto=format&fit=crop&w=1800&q=85" alt="Bangunan kedai warisan berwarna-warni di George Town"/><span class="photo-stamp">GEORGE TOWN<br/>5°25′N · 100°20′E</span></div></section>
      <section class="intro section" id="cerita"><div class="section-kicker">01 / CERITA TEMPAT</div><div class="intro-grid"><h2>Satu bandar.<br/><span>Banyak pertemuan.</span></h2><div><p class="big-copy">Di sini, sejarah bukan sekadar tarikh. Ia hadir dalam bentuk pintu kayu, jubin encaustic, bunyi loceng kuil dan bau rempah yang keluar dari lorong sempit.</p><p>George Town berkembang sebagai pelabuhan entrepôt di Selat Melaka. Lapisan Melayu, Cina, India, Eropah dan komuniti peranakan membentuk sebuah landskap bandar yang sukar ditemui di tempat lain.</p><a class="text-link" href="https://whc.unesco.org/en/list/1223/" target="_blank" rel="noreferrer">Baca tentang nilai sejagat luar biasa ↗</a></div></div></section>
      <section class="feature-band"><div class="feature-image"><img src="https://images.unsplash.com/photo-1539650116574-75c0c6d73f6e?auto=format&fit=crop&w=1400&q=85" alt="Deretan shophouse warisan dengan tingkap hijau" loading="lazy"/></div><div class="feature-copy"><p class="eyebrow">SEKILAS PANDANG</p><blockquote>“Sebuah contoh luar biasa bandar perdagangan pelbagai budaya di Asia Tenggara.”</blockquote><p>Mulakan di Lebuh Chulia, biarkan kaki memilih simpang. Setiap blok membuka satu lagi bab: rumah kongsi, masjid, kuil, gereja dan kedai kopi yang masih menjadi sebahagian daripada kehidupan harian.</p><div class="stat-row"><div><strong>4.4</strong><span>penilaian peta<br/>13,491 ulasan</span></div><div><strong>FREE</strong><span>akses kawasan<br/>warisan terbuka</span></div></div></div></section>
      <section class="routes section" id="laluan"><div class="section-kicker">02 / LALUAN PILIHAN</div><div class="section-head"><h2>Tiga cara membaca<br/><span>George Town.</span></h2><p>Jangan kejar semuanya. Pilih satu tema, berjalan perlahan, dan biarkan bandar memberi kejutan kecil.</p></div><div class="cards">{attractions.map((item, i)=><article class="place-card"><div class="card-image"><img src={item.image} alt={item.title} loading="lazy"/><span>0{i+1}</span></div><p class="card-tag">{item.tag}</p><h3>{item.title}</h3><p>{item.text}</p><button class="card-save" data-save={item.title}>＋ Simpan</button></article>)}</div></section>
      <section class="practical section" id="praktikal"><div class="section-kicker">03 / RANCANG DENGAN TENANG</div><div class="practical-grid"><div><h2>Butiran kecil<br/><span>yang membantu.</span></h2><p class="big-copy">Datang dengan rasa ingin tahu, bukan senarai semak. Berikut asas untuk menjadikan hari anda lebih lancar.</p></div><div class="info-list"><details open><summary><span>01</span> Pengangkutan terperinci <b>＋</b></summary><div class="detail-content"><p><strong>Lapangan Terbang Antarabangsa Pulau Pinang</strong><br/>Dari Bayan Lepas, ambil Rapid Penang 102 atau 401E ke pusat bandar; teksi dan e-hailing lebih terus. Anggarkan 35–60 minit bergantung trafik.</p><p><strong>Bas awam</strong><br/>Rapid Penang menghubungkan terminal KOMTAR dengan banyak kawasan bandar. Turun di sekitar Lebuh Chulia / KOMTAR dan sambung berjalan.</p><p><strong>Teksi & e-hailing</strong><br/>Minta turun di Lebuh Chulia atau KOMTAR. Jalan warisan mempunyai lorong sempit dan jalan sehala; berjalan kaki biasanya lebih cepat untuk jarak dekat.</p></div></details><details><summary><span>02</span> Tiket, kos & waktu <b>＋</b></summary><div class="detail-content"><p>Kawasan warisan terbuka boleh diterokai secara percuma. Muzium, rumah kongsi dan tarikan berbayar mempunyai tiket sendiri. Google Maps menyenaraikan lokasi ini sebagai dibuka setiap hari dan ditutup sekitar 17:00; semak papan tanda di lokasi kerana waktu boleh berubah.</p></div></details><details><summary><span>03</span> Tempat letak kereta <b>＋</b></summary><div class="detail-content"><p>Ruang parkir jalanan di pusat warisan adalah terhad. Gunakan tempat letak kereta berbayar sekitar KOMTAR, Prangin Mall atau kawasan persisiran, kemudian berjalan / gunakan bas CAT percuma jika tersedia.</p></div></details><details><summary><span>04</span> Masa terbaik & tempoh <b>＋</b></summary><div class="detail-content"><p>07:30–10:30 paling selesa untuk fasad dan fotografi; 16:00 hingga senja sesuai untuk lorong dan seni jalanan. Peruntukkan 3–4 jam untuk laluan ringkas, atau satu hari untuk menjelajah tanpa tergesa-gesa.</p></div></details></div></div></section>
      <section class="food section"><div class="food-photo"><img src="https://images.unsplash.com/photo-1515003197210-e0cd71810b5f?auto=format&fit=crop&w=1200&q=85" alt="Hidangan jalanan Penang di atas meja" loading="lazy"/></div><div class="food-copy"><p class="section-kicker">04 / MAKAN DI SEKITAR</p><h2>Warisan yang<br/><span>boleh dirasa.</span></h2><p>Rancang satu hentian makan, bukan sekadar rehat. Cuba char kway teow, asam laksa, nasi kandar, cendol atau kuih-muih Nyonya di kedai dan gerai yang sibuk dengan penduduk tempatan.</p><div class="food-tags"><span>Char kway teow</span><span>Asam laksa</span><span>Nasi kandar</span><span>Cendol</span></div></div></section>
      <section class="nearby section"><div class="section-kicker">05 / LANJUTKAN LANGKAH</div><div class="nearby-head"><h2>Selepas ini,<br/><span>ke mana?</span></h2><p>Gunakan George Town sebagai titik mula. Tarikan berdekatan ini mudah digabungkan mengikut tenaga dan cuaca.</p></div><div class="nearby-grid"><div><span>01</span><h3>Fort Cornwallis</h3><p>Kubu pesisir untuk memahami permulaan kolonial Pulau Pinang.</p></div><div><span>02</span><h3>Clan Jetties</h3><p>Komuniti rumah air dengan pemandangan Selat Melaka.</p></div><div><span>03</span><h3>Little India</h3><p>Rempah, tekstil, muzik dan kuil di jalan yang meriah.</p></div></div></section>
      <section class="map-section"><div class="map-copy"><p class="section-kicker">06 / BUKA PETA</p><h2>Mulakan di<br/><span>Lebuh Chulia.</span></h2><p>Alamat rujukan: 159, Lebuh Chulia, 10200 George Town, Pulau Pinang.</p><a class="button light" href="https://maps.app.goo.gl/iTorS1Eh1hJkpMXp9" target="_blank" rel="noreferrer">Buka dalam Google Maps ↗</a></div><div class="map-frame"><iframe title="Peta George Town UNESCO Historic Site" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3971.999760586508!2d100.3353972121393!3d5.417003694539544!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x304ac391217398d1%3A0xe3374c478de7ca59!2sGeorgetown%20UNESCO%20Historic%20Site!5e0!3m2!1sms!2smy!4v1786539797328!5m2!1sms!2smy" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
      <section class="faq section"><div class="section-kicker">07 / SOALAN LAZIM</div><h2>Anda tanya,<br/><span>kami jawab.</span></h2><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<b>＋</b></summary><p>{a}</p></details>)}</div></section>
      <section class="plan section"><div><p class="section-kicker">PELAN SIMPANAN ANDA</p><h2>Jangan biarkan<br/><span>cerita berlalu.</span></h2><p>Tekan “Simpan” pada tempat yang anda mahu lawati. Senarai ini hanya disimpan pada peranti anda — tiada akaun, tiada pelayan.</p></div><div class="saved-box"><div class="saved-head"><strong>Tempat pilihan</strong><span id="saved-count">0 tempat</span></div><ul id="saved-list"><li class="empty">Belum ada tempat disimpan.<br/>Pilih satu laluan di atas untuk bermula.</li></ul><button class="clear-saves" id="clear-saves">Kosongkan senarai</button></div></section>
    </main>
    <footer><div class="footer-brand"><span class="brand-mark">GT</span><span>JEJAK WARISAN</span></div><p>Nota: Laman ini ialah panduan tidak rasmi dan tidak berafiliasi dengan UNESCO, kerajaan tempatan atau mana-mana tarikan yang disenaraikan.</p><span>© George Town · Jalan perlahan, lihat lebih banyak.</span></footer>
    <script is:inline>
      const key='gt-saved-places'; const load=()=>JSON.parse(localStorage.getItem(key)||'[]'); const render=()=>{const saved=load(); const list=document.querySelector('#saved-list'); const count=document.querySelector('#saved-count'); if(!list||!count)return; count.textContent=saved.length+' tempat'; list.innerHTML=saved.length?saved.map(x=>`<li>${x}<button aria-label="Hapus ${x}" data-remove="${x}">×</button></li>`).join(''):'<li class="empty">Belum ada tempat disimpan.<br/>Pilih satu laluan di atas untuk bermula.</li>'; document.querySelectorAll('[data-remove]').forEach(b=>b.addEventListener('click',()=>{localStorage.setItem(key,JSON.stringify(load().filter(x=>x!==b.dataset.remove)));render()}))}; document.querySelectorAll('[data-save]').forEach(b=>b.addEventListener('click',()=>{const n=b.dataset.save; const s=load(); if(!s.includes(n))s.push(n);localStorage.setItem(key,JSON.stringify(s));render();b.textContent='✓ Disimpan'})); document.querySelector('#clear-saves')?.addEventListener('click',()=>{localStorage.removeItem(key);render()}); render();
    </script>
  </body>
</html>
