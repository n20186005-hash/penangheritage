---
// Design philosophy: Straits Heritage Editorial — warm limewash, indigo ink, brass accents,
// asymmetric editorial rhythm, archival labels, and map-led storytelling for a living historic city.
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const canonical = siteUrl ? `${siteUrl}${Astro.url.pathname}` : Astro.url.pathname;
import '../styles.css';

const history = [
  { title: '1786：东方之珠', text: '莱特船长的登陆点燃了这座自由港。自由贸易、免税政策与各族移民的涌入，让乔治市迅速成长为马六甲海峡重要的转口港，也是今天多元城市性格的起点。' },
  { title: '五方族群的交响', text: '马来、华、印、欧与娘惹峇峇（Peranakan）社群在同一片街区比邻而居。清真寺、宗祠、教堂与庙宇相距不过数百米，形成罕有的并置奇观——这正是其世界遗产价值的核心。' },
  { title: '传说与掌故', text: '街头巷尾流传着无数故事：老屋门楣的雕饰藏着家族祝愿，地名往往来自昔日传说。建筑不只是砖石，更是一代代移民记忆的容器，等待有心人驻足解读。' }
];
const attractions = [
  { title: '姓氏桥', tag: '水上社区', text: '走进海上木屋与潮汐之间，感受槟城华人移民社群的日常尺度。', image: '/gallery/georgetown-unesco-historic-site-21.jpg' },
  { title: '壁画街区', tag: '城市漫游', text: '沿着 Lebuh Armenian 与周边小巷寻找铁艺壁画和街头艺术。', image: '/gallery/georgetown-unesco-historic-site-2.jpg' },
  { title: '邱公司', tag: '宗祠建筑', text: '精雕木作、金箔与宗族记忆，构成乔治市最具戏剧性的室内空间。', image: '/gallery/georgetown-unesco-historic-site-8.jpg' }
];
const faqs = [
  ['乔治市 UNESCO 世界遗产区需要门票吗？', '历史街区本身开放步行参观，不收取统一门票。部分宗祠、博物馆和付费景点会另行售票，出发前请查看各自现场公告。'],
  ['从槟城国际机场怎么到这里？', '机场距离乔治市约 18 公里。可搭乘 Rapid Penang 公交，或使用出租车与网约车；行车时间会随交通状况变化，建议预留 35–60 分钟。'],
  ['适合安排多长时间？', '第一次到访建议留出半天至一天。若想慢慢看建筑、吃街头小吃并加入姓氏桥路线，一整天更从容。'],
  ['什么时候最适合步行？', '清晨与傍晚光线柔和、体感相对舒适。中午可把时间留给室内展馆、咖啡馆或一顿悠闲的娘惹菜。'],
  ['附近有洗手间和母婴设施吗？', '公共厕所、商场洗手间与大型超市通常分布在主要商圈和交通枢纽周边，并非每一条老街巷都有。出发前先在电子地图上标记一两个确定开放的洗手间；若有婴幼儿同行，可优先留意大型商场与博物馆内的母婴室。'],
  ['可以开车进入遗产区吗？', '核心遗产区以步行为主，老街多单行道且路幅狭窄，不适合驾车游览。建议把车停在周边收费停车场或购物中心车库，再步行或以免费接驳方式进入。'],
  ['带轮椅或推婴儿车方便吗？', '主街道人行道相对平整，但部分老街区石板路、门槛与狭窄骑楼对轮椅并不友好。建议选择主干道与有坡道的新路段，宗祠室内常有门槛台阶；可提前规划缓行的路线并预留更充裕时间。'],
  ['周边有住宿选择吗？', '遗产区内外有从平价旅馆到中高档酒店与精品民宿的不同档位选择。多数步行可达主要景点，适合想把游览分散到清晨与傍晚的游客；不同价位对应的设施与位置差异较大，建议按预算与动线自行比较。'],
  ['餐饮和补给方便吗？', '很方便。小贩中心、咖啡店、便利商店与超市分布密集，正餐、快餐与街头小食选择丰富。想省钱的话，小贩中心和路边摊通常性价比更高；也可以随时在便利商店补给饮用水与日用。'],
  ['有推荐的步行着装吗？', '槟城全年炎热潮湿。建议穿轻便透气、易干的衣物，配舒适的防滑步行鞋，并随身带水、防晒与雨具。若计划进入宗教场所，请按当地礼仪着装、遮肩，并遵守脱鞋规定。']
];
const gallery = Array.from({ length: 21 }, (_, i) => `/gallery/georgetown-unesco-historic-site-${i + 1}.jpg`);
---
<!doctype html>
<html lang="ms">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>George Town UNESCO — Jejak Warisan</title>
    <meta name="description" content="Panduan berjalan kaki ke tapak Warisan Dunia UNESCO George Town, Pulau Pinang — sejarah, pengangkutan, makanan dan laluan pilihan." />
    <link rel="canonical" href={canonical} />
    {siteUrl && <meta property="og:url" content={canonical} />}
    <meta property="og:title" content="George Town UNESCO — Jejak Warisan" />
    <meta property="og:description" content="Satu bandar pelabuhan, banyak lapisan cerita." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteUrl}/gallery/georgetown-unesco-historic-site-1.jpg`} />
    <link rel="icon" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-HXM22WWPKP');</script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context':'https://schema.org','@type':'TouristAttraction','name':'George Town UNESCO Historic Site','description':'Historic core of George Town, Penang, recognised for its unique architectural and cultural townscape.','address':{'@type':'PostalAddress','streetAddress':'159, Lebuh Chulia','addressLocality':'George Town','postalCode':'10200','addressRegion':'Pulau Pinang','addressCountry':'MY'},'geo':{'@type':'GeoCoordinates','latitude':5.417003694539544,'longitude':100.3353972121393},'openingHours':'Mo-Su 00:00-23:59','isAccessibleForFree':true,'aggregateRating':{'@type':'AggregateRating','ratingValue':'4.4','ratingCount':'13491'}
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'FAQPage','mainEntity':faqs.map(([q,a])=>({'@type':'Question','name':q,'acceptedAnswer':{'@type':'Answer','text':a}}))})} />
  </head>
  <body>
    <header class="topbar"><a class="brand" href="#top" aria-label="Laman utama"><span class="brand-mark">GT</span><span>JEJAK<br/><b>WARISAN</b></span></a><nav><a href="#cerita">Cerita</a><a href="#sejarah">Sejarah</a><a href="#laluan">Laluan</a><a href="#praktikal">Praktikal</a><a href="#galeri">Galeri</a></nav><button class="save-top" data-save="George Town UNESCO Historic Site">＋ Simpan pelan</button></header>
    <main id="top">
      <section class="hero"><div class="hero-copy"><p class="eyebrow">PULAU PINANG · MALAYSIA</p><h1>Bandar pelabuhan,<br/><em>seribu lapis cerita.</em></h1><p class="lede">George Town UNESCO Historic Site bukan muzium yang beku. Ia ialah bandar yang masih bernafas — di antara kedai lama, rumah ibadat, gerai sarapan dan bayang petang.</p><div class="hero-actions"><a class="button dark" href="#laluan">Mulakan berjalan <span>↘</span></a><button class="button outline" data-save="Laluan George Town">＋ Simpan laluan</button></div><div class="hero-note"><span>01</span><p>Tapak Warisan Dunia UNESCO sejak 2008<br/><small>Berjalan kaki adalah cara terbaik untuk membaca bandar ini.</small></p></div></div><div class="hero-image"><img src="/gallery/georgetown-unesco-historic-site-1.jpg" alt="Bangunan kedai warisan berwarna-warni di George Town"/><span class="photo-stamp">GEORGE TOWN<br/>5°25′N · 100°20′E</span></div></section>
      <section class="intro section" id="cerita"><div class="section-kicker">01 / CERITA TEMPAT</div><div class="intro-grid"><h2>Satu bandar.<br/><span>Banyak pertemuan.</span></h2><div><p class="big-copy">Di sini, sejarah bukan sekadar tarikh. Ia hadir dalam bentuk pintu kayu, jubin encaustic, bunyi loceng kuil dan bau rempah yang keluar dari lorong sempit.</p><p>George Town berkembang sebagai pelabuhan entrepôt di Selat Melaka. Lapisan Melayu, Cina, India, Eropah dan komuniti peranakan membentuk sebuah landskap bandar yang sukar ditemui di tempat lain.</p><a class="text-link" href="https://whc.unesco.org/en/list/1223/" target="_blank" rel="noreferrer">Baca tentang nilai sejagat luar biasa ↗</a><img class="intro-image" src="/gallery/georgetown-unesco-historic-site-7.jpg" alt="Suasana jalan bersejarah George Town" loading="lazy"/></div></div></section>
      <section class="feature-band"><div class="feature-image"><img src="/gallery/georgetown-unesco-historic-site-2.jpg" alt="Deretan shophouse warisan dengan tingkap hijau" loading="lazy"/></div><div class="feature-copy"><p class="eyebrow">SEKILAS PANDANG</p><blockquote>“Sebuah contoh luar biasa bandar perdagangan pelbagai budaya di Asia Tenggara.”</blockquote><p>Mulakan di Lebuh Chulia, biarkan kaki memilih simpang. Setiap blok membuka satu lagi bab: rumah kongsi, masjid, kuil, gereja dan kedai kopi yang masih menjadi sebahagian daripada kehidupan harian.</p><div class="stat-row"><div><strong>4.4</strong><span>penilaian peta<br/>13,491 ulasan</span></div><div><strong>FREE</strong><span>akses kawasan<br/>warisan terbuka</span></div></div></div></section>
      <section class="history section" id="sejarah"><div class="section-kicker">02 / SEJARAH & LEGENDA</div><div class="history-grid">{history.map((h,i)=><article><span>0{i+1}</span><h3>{h.title}</h3><p>{h.text}</p></article>)}</div><p class="history-note">Sumber: naratif sejarah awam dan penulisan warisan George Town. Laman ini bukan sumber akademik rasmi; untuk rujukan terperinci, lihat pangkalan data UNESCO.</p></section>
      <section class="routes section" id="laluan"><div class="section-kicker">03 / LALUAN PILIHAN</div><div class="section-head"><h2>Tiga cara membaca<br/><span>George Town.</span></h2><p>Jangan kejar semuanya. Pilih satu tema, berjalan perlahan, dan biarkan bandar memberi kejutan kecil.</p></div><div class="cards">{attractions.map((item, i)=><article class="place-card"><div class="card-image"><img src={item.image} alt={item.title} loading="lazy"/><span>0{i+1}</span></div><p class="card-tag">{item.tag}</p><h3>{item.title}</h3><p>{item.text}</p><button class="card-save" data-save={item.title}>＋ Simpan</button></article>)}</div></section>
      <section class="practical section" id="praktikal"><div class="section-kicker">04 / RANCANG DENGAN TENANG</div><div class="practical-grid"><div><h2>Butiran kecil<br/><span>yang membantu.</span></h2><p class="big-copy">Datang dengan rasa ingin tahu, bukan senarai semak. Berikut asas untuk menjadikan hari anda lebih lancar.</p></div><div class="info-list"><details open><summary><span>01</span> Pengangkutan terperinci <b>＋</b></summary><div class="detail-content"><p><strong>Lapangan Terbang Antarabangsa Pulau Pinang</strong><br/>Dari Bayan Lepas, ambil Rapid Penang 102 atau 401E ke pusat bandar; teksi dan e-hailing lebih terus. Anggarkan 35–60 minit bergantung trafik.</p><p><strong>Bas awam</strong><br/>Rapid Penang menghubungkan terminal KOMTAR dengan banyak kawasan bandar. Turun di sekitar Lebuh Chulia / KOMTAR dan sambung berjalan.</p><p><strong>Teksi & e-hailing</strong><br/>Minta turun di Lebuh Chulia atau KOMTAR. Jalan warisan mempunyai lorong sempit dan jalan sehala; berjalan kaki biasanya lebih cepat untuk jarak dekat.</p></div></details><details><summary><span>02</span> Tiket, kos & waktu <b>＋</b></summary><div class="detail-content"><p>Kawasan warisan terbuka boleh diterokai secara percuma. Muzium, rumah kongsi dan tarikan berbayar mempunyai tiket sendiri. Waktu operasi berbeza; kebanyakan tempat dibuka setiap hari dan ada yang ditutup sekitar 17:00. Semak papan tanda di lokasi kerana waktu boleh berubah mengikut musim dan hari perayaan.</p></div></details><details><summary><span>03</span> Tempat letak kereta <b>＋</b></summary><div class="detail-content"><p>Ruang parkir jalanan di pusat warisan adalah terhad dan banyak jalan sehala. Gunakan tempat letak kereta berbayar atau bangunan parkir sekitar KOMTAR dan kawasan persisiran, kemudian berjalan atau naik bas CAT percuma jika tersedia. Elakkan membawa kenderaan bersaiz besar ke lorong sempit.</p></div></details><details><summary><span>04</span> Kemudahan & tandas awam <b>＋</b></summary><div class="detail-content"><p>Kawasan warisan berjalan kaki yang panjang; tandas awam tidak tersebar di setiap lorong. Tandas kemudahan awam biasanya terdapat di pusat beli-belah besar, stesen pengangkutan dan beberapa muzium. Cari papan tanda atau semak peta dalam talian sebelum berjalan jauh. Sebaiknya bawa bekalan air minuman sendiri kerana terdapat banyak jalan yang teduh tetapi cuaca panas.</p></div></details><details><summary><span>05</span> Penginapan berdekatan <b>＋</b></summary><div class="detail-content"><p>Terdapat pelbagai pilihan penginapan di dalam dan sekitar tapak warisan — dari asrama bajet, homestay, hotel butik, hingga hotel mewah. Penginapan di dalam kawasan bersejarah membolehkan anda menerokai kawasan itu pada awal pagi dan lewat petang apabila kurang sesak. Semak lokasi relatif kepada laluan anda, akses bas dan tahap bunyi di kawasan itu sebelum menempah.</p></div></details><details><summary><span>06</span> Makan & bekalan <b>＋</b></summary><div class="detail-content"><p>Makanan jalanan, kedai kopi, restoran dan kedai serbaneka mudah ditemui. Banyak lorong dipenuhi gerai dan restoran tempatan yang sibuk dengan penduduk tempatan. Kedai serbaneka dan pasar mini mudah ditemui untuk bekalan air, makanan ringan dan barangan harian. Untuk pilihan yang lebih meluas, pergi ke kompleks beli-belah atau pasar basah berhampiran.</p></div></details><details><summary><span>07</span> Akses & kebolehcapaian <b>＋</b></summary><div class="detail-content"><p>Jalan utama agak rata dan mudah dilalui dengan kerusi roda atau kereta sorong, tetapi sesetengah lorong lama, batu lorong dan ambang tinggi boleh menyukarkan. Banyak rumah ibadat dan rumah kongsi mempunyai anak tangga. Rancang laluan melalui jalan utama, gunakan laluan pejalan kaki dan minta bantuan jika perlu. Masa yang lebih panjang dan perhentian yang kerap disyorkan.</p></div></details><details><summary><span>08</span> Masa terbaik & tempoh <b>＋</b></summary><div class="detail-content"><p>07:30–10:30 paling selesa untuk fasad dan fotografi; 16:00 hingga senja sesuai untuk lorong dan seni jalanan. Peruntukkan 3–4 jam untuk laluan ringkas, atau satu hari untuk menjelajah tanpa tergesa-gesa. Elakkan tengah hari jika sensitif terhadap panas.</p></div></details></div></div></section>
      <section class="food section"><div class="food-photo"><img src="/gallery/georgetown-unesco-historic-site-6.jpg" alt="Hidangan jalanan Penang di atas meja" loading="lazy"/></div><div class="food-copy"><p class="section-kicker">05 / MAKAN DI SEKITAR</p><h2>Warisan yang<br/><span>boleh dirasa.</span></h2><p>Rancang satu hentian makan, bukan sekadar rehat. Cuba char kway teow, asam laksa, nasi kandar, cendol atau kuih-muih Nyonya di kedai dan gerai yang sibuk dengan penduduk tempatan.</p><div class="food-tags"><span>Char kway teow</span><span>Asam laksa</span><span>Nasi kandar</span><span>Cendol</span></div></div></section>
      <section class="nearby section"><div class="section-kicker">06 / LANJUTKAN LANGKAH</div><div class="nearby-head"><h2>Selepas ini,<br/><span>ke mana?</span></h2><p>Gunakan George Town sebagai titik mula. Tarikan berdekatan ini mudah digabungkan mengikut tenaga dan cuaca.</p></div><div class="nearby-grid"><div><span>01</span><h3>Fort Cornwallis</h3><p>Kubu pesisir untuk memahami permulaan kolonial Pulau Pinang.</p></div><div><span>02</span><h3>Clan Jetties</h3><p>Komuniti rumah air dengan pemandangan Selat Melaka.</p></div><div><span>03</span><h3>Little India</h3><p>Rempah, tekstil, muzik dan kuil di jalan yang meriah.</p></div></div><p class="nearby-note">Jika masa mengizinkan, gabungkan dengan kaki bukit Penang atau pantai Batu Ferringhi untuk perjalanan sehari penuh.</p></section>
      <section class="gallery section" id="galeri"><div class="section-kicker">07 / GALERI</div><div class="gallery-head"><h2>Bingkai memori<br/><span>dari setiap sudut.</span></h2><p>Sebuah pratinjau visual sebelum kaki anda mula melangkah.</p></div><div class="gallery-grid">{gallery.map((src,i)=><button class="gallery-item" data-full={src} aria-label={`Gambar ${i+1}`}><img src={src} alt={`George Town UNESCO — gambar ${i+1}`} loading="lazy"/></button>)}</div><div class="lightbox" id="lightbox" hidden><button class="lightbox-close" aria-label="Tutup">×</button><img id="lightbox-img" src="" alt="Gambar besar"/></div></section>
      <section class="map-section"><div class="map-copy"><p class="section-kicker">08 / BUKA PETA</p><h2>Mulakan di<br/><span>Lebuh Chulia.</span></h2><p>Alamat rujukan: 159, Lebuh Chulia, 10200 George Town, Pulau Pinang.</p><a class="button light" href="https://maps.app.goo.gl/iTorS1Eh1hJkpMXp9" target="_blank" rel="noreferrer">Buka dalam Google Maps ↗</a></div><div class="map-frame"><iframe title="Peta George Town UNESCO Historic Site" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3971.999760586508!2d100.3353972121393!3d5.417003694539544!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x304ac391217398d1%3A0xe3374c478de7ca59!2sGeorgetown%20UNESCO%20Historic%20Site!5e0!3m2!1sms!2smy!4v1786539797328!5m2!1sms!2smy" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></div></section>
      <section class="faq section"><div class="section-kicker">09 / SOALAN LAZIM</div><h2>Anda tanya,<br/><span>kami jawab.</span></h2><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}<b>＋</b></summary><p>{a}</p></details>)}</div></section>
      <section class="plan section"><div><p class="section-kicker">PELAN SIMPANAN ANDA</p><h2>Jangan biarkan<br/><span>cerita berlalu.</span></h2><p>Tekan “Simpan” pada tempat yang anda mahu lawati. Senarai ini hanya disimpan pada peranti anda — tiada akaun, tiada pelayan.</p></div><div class="saved-box"><div class="saved-head"><strong>Tempat pilihan</strong><span id="saved-count">0 tempat</span></div><ul id="saved-list"><li class="empty">Belum ada tempat disimpan.<br/>Pilih satu laluan di atas untuk bermula.</li></ul><button class="clear-saves" id="clear-saves">Kosongkan senarai</button></div></section>
    </main>
    <footer><div class="footer-brand"><span class="brand-mark">GT</span><span>JEJAK WARISAN</span></div><p>Nota: Laman ini ialah panduan tidak rasmi dan tidak berafiliasi dengan UNESCO, kerajaan tempatan atau mana-mana tarikan yang disenaraikan.</p><span>© George Town · Jalan perlahan, lihat lebih banyak.</span></footer>
    <script is:inline>
      const key='gt-saved-places'; const load=()=>JSON.parse(localStorage.getItem(key)||'[]'); const render=()=>{const saved=load(); const list=document.querySelector('#saved-list'); const count=document.querySelector('#saved-count'); if(!list||!count)return; count.textContent=saved.length+' tempat'; list.innerHTML=saved.length?saved.map(x=>`<li>${x}<button aria-label="Hapus ${x}" data-remove="${x}">×</button></li>`).join(''):'<li class="empty">Belum ada tempat disimpan.<br/>Pilih satu laluan di atas untuk bermula.</li>'; document.querySelectorAll('[data-remove]').forEach(b=>b.addEventListener('click',()=>{localStorage.setItem(key,JSON.stringify(load().filter(x=>x!==b.dataset.remove)));render()}))}; document.querySelectorAll('[data-save]').forEach(b=>b.addEventListener('click',()=>{const n=b.dataset.save; const s=load(); if(!s.includes(n))s.push(n);localStorage.setItem(key,JSON.stringify(s));render();b.textContent='✓ Disimpan'})); document.querySelector('#clear-saves')?.addEventListener('click',()=>{localStorage.removeItem(key);render()}); render(); const lbox=document.getElementById('lightbox'); const limg=document.getElementById('lightbox-img'); document.querySelectorAll('.gallery-item').forEach(b=>b.addEventListener('click',()=>{if(!limg)return; limg.setAttribute('src',b.getAttribute('data-full')||''); if(lbox)lbox.removeAttribute('hidden'); document.body.style.overflow='hidden'})); lbox?.addEventListener('click',e=>{const t=e.target; if(t===lbox||(t instanceof Element&&t.classList.contains('lightbox-close'))){lbox.setAttribute('hidden',''); document.body.style.overflow=''}});
    </script>
  </body>
</html>
